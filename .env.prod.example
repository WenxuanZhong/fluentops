# =============================================================================
# FluentOps production environment template.
# Copy to .env.prod and replace every REPLACE_ME value before release.
# Do not use mock providers or development credentials in production.
# =============================================================================

# ---- Runtime ----
NODE_ENV=production
PORT=3000
FLUENTOPS_IMAGE_TAG=REPLACE_ME_RELEASE_TAG
# Defaults are production ports 80/443 and volumes fluentops_{pg,minio}_data.
# CI smoke tests override these to avoid clashing with real deployments.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
FLUENTOPS_VOLUME_PREFIX=fluentops
NGINX_CERTS_DIR=./nginx/certs
CURL_IMAGE=curlimages/curl:8.11.1

# ---- Database ----
POSTGRES_DB=fluentops
POSTGRES_USER=fluentops
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD

# ---- Auth (24+ chars, random, secrets must differ) ----
JWT_SECRET=REPLACE_ME_64_CHAR_RANDOM_JWT_SECRET
REFRESH_SECRET=REPLACE_ME_64_CHAR_RANDOM_REFRESH_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
WS_TICKET_TTL=60s

# Same-host deployments can leave COOKIE_DOMAIN blank.
# Split subdomain deployments can use an apex such as .example.com.
COOKIE_DOMAIN=
CORS_ORIGIN=https://app.example.com

# ---- Cache ----
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

# ---- Object storage ----
MINIO_ACCESS_KEY=REPLACE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=fluentops
MINIO_PUBLIC_URL=https://app.example.com/objects

# ---- AI provider ----
AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.7

# ---- Billing provider ----
BILLING_PROVIDER=alipay
ALIPAY_APP_ID=REPLACE_ME_ALIPAY_APP_ID
ALIPAY_PRIVATE_KEY=REPLACE_ME_ALIPAY_PRIVATE_KEY
ALIPAY_PUBLIC_KEY=REPLACE_ME_ALIPAY_PUBLIC_KEY
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://app.example.com/api/v1/billing/alipay/notify

# ---- Email provider ----
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=REPLACE_ME_RESEND_API_KEY

# Same-host nginx deployment should use /api/v1.
VITE_API_BASE_URL=/api/v1
