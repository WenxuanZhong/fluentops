# =============================================================================
# FluentOps environment template.
# - For development: copy to .env and use the values below as-is.
# - For production: use .env.prod.example instead of this development template.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3000
FLUENTOPS_IMAGE_TAG=local

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fluentops
POSTGRES_USER=fluentops
POSTGRES_PASSWORD=fluentops
DATABASE_URL=postgresql://fluentops:fluentops@localhost:5432/fluentops

# ---- Auth (REQUIRED in production; 24+ random chars, secrets must differ) ----
#   openssl rand -hex 32
JWT_SECRET=your-jwt-secret-change-in-production
REFRESH_SECRET=your-refresh-secret-change-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
WS_TICKET_TTL=60s

# Refresh cookie domain. Set to your apex (e.g. ".fluentops.app") if you host
# api and web on different subdomains. Leave blank for same-host setups.
COOKIE_DOMAIN=

# ---- CORS (REQUIRED in production) ----
CORS_ORIGIN=http://localhost:5173

# ---- Cache (REQUIRED in production) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---- Object storage (defaults below MUST be replaced in production) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123456
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123456
MINIO_BUCKET=fluentops
MINIO_PUBLIC_URL=http://localhost:9000

# ---- AI provider (REQUIRED in production; AI_PROVIDER=mock is rejected) ----
AI_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key
MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.7

# ---- Billing provider (REQUIRED in production; BILLING_PROVIDER=mock is rejected) ----
BILLING_PROVIDER=mock
# Alipay (required when BILLING_PROVIDER=alipay)
# ALIPAY_APP_ID=your-sandbox-app-id
# ALIPAY_PRIVATE_KEY=your-app-private-key
# ALIPAY_PUBLIC_KEY=alipay-public-key
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/billing/notify

# ---- Email provider (REQUIRED in production; EMAIL_PROVIDER=mock is rejected) ----
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@fluentops.local
# RESEND_API_KEY=your-resend-api-key   # required when EMAIL_PROVIDER=resend

# ---- Web build-time ----
VITE_API_BASE_URL=http://localhost:3000/api/v1
