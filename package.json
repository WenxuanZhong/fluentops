{
  "name": "fluentops",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": "9.15.4"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "4.5.4",
      "glob": "10.5.0",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@3.1.3": "3.1.4",
      "minimatch@9.0.1": "9.0.7",
      "minimatch@9.0.5": "9.0.7",
      "minimatch@9.0.6": "9.0.7",
      "rollup": "4.59.0",
      "multer": "2.1.1",
      "flatted": "3.4.0",
      "serialize-javascript": "7.0.3",
      "undici": "7.24.0"
    }
  },
  "scripts": {
    "doctor:env": "node ./scripts/doctor.mjs",
    "toolchain:check": "node ./scripts/check-toolchain.mjs --mode=strict",
    "verify:local": "node ./scripts/verify-local.mjs",
    "verify:api:e2e": "node ./scripts/check-toolchain.mjs --mode=warn && node ./scripts/run-pnpm.mjs --filter api-gateway test:e2e",
    "verify:api:e2e:realdb": "node ./scripts/check-toolchain.mjs --mode=warn && node ./scripts/run-pnpm.mjs --env E2E_USE_REAL_DB=true --filter api-gateway test:e2e",
    "infra:start": "node ./scripts/infra.mjs start",
    "infra:stop": "node ./scripts/infra.mjs stop",
    "infra:reset": "node ./scripts/infra.mjs reset",
    "infra:status": "node ./scripts/infra.mjs status",
    "infra:logs": "node ./scripts/infra.mjs logs",
    "infra:wait": "node ./scripts/infra.mjs wait",
    "dev": "node ./scripts/check-toolchain.mjs --mode=warn && node ./scripts/run-turbo.mjs dev --parallel",
    "lint": "node ./scripts/check-toolchain.mjs --mode=warn && node ./scripts/run-turbo.mjs lint",
    "typecheck": "node ./scripts/check-toolchain.mjs --mode=warn && node ./scripts/run-turbo.mjs typecheck",
    "test": "node ./scripts/check-toolchain.mjs --mode=warn && node ./scripts/run-turbo.mjs test",
    "build": "node ./scripts/check-toolchain.mjs --mode=warn && node ./scripts/run-turbo.mjs build",
    "audit": "node ./scripts/check-toolchain.mjs --mode=warn && pnpm audit --audit-level=high",
    "format": "node ./scripts/check-toolchain.mjs --mode=warn && prettier . --check",
    "format:write": "node ./scripts/check-toolchain.mjs --mode=warn && prettier . --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^25.2.2",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.4.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3"
  }
}
