# Edge proxy for fluentops.
# Pair with a TLS terminator (Caddy, Cloudflare, or this same nginx with certs mounted at
# /etc/nginx/certs/fullchain.pem and /etc/nginx/certs/privkey.pem) — this file shows the
# "with certs" variant. If TLS is terminated upstream, strip the listen 443 block.

upstream fluentops_api {
  server api-gateway:3000;
  keepalive 32;
}

upstream fluentops_web {
  server web:80;
  keepalive 16;
}

# Force HTTPS
server {
  listen 80;
  server_name _;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name _;

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # HSTS — only enable after you're sure HTTPS is permanent
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  client_max_body_size 100m;

  # API
  location /api/ {
    proxy_pass http://fluentops_api;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id      $request_id;
    proxy_read_timeout 600s;     # SSE streams
    proxy_buffering off;          # don't buffer SSE
    proxy_cache off;
  }

  # WebSocket
  location /ws/ {
    proxy_pass http://fluentops_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Static SPA
  location / {
    proxy_pass http://fluentops_web;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
